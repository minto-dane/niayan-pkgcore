-- SPDX-License-Identifier: MIT
project Tests is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "vendor/resolver/src", "runtime", "vendor/contracts/src", "vendor/contracts/runtime", "tests");
   for Object_Dir use "build/test-obj";
   for Exec_Dir use "build/test-bin";
   for Main use ("run_generation_stage_tests.adb", "run_deb_semantics_tests.adb", "run_pkg_resolution_tests.adb", "run_file_replay_tests.adb", "run_composition_tests.adb", "run_pkg_tests.adb", "run_rpm_tests.adb", "run_journal_io_tests.adb", "run_v2_pkg_tests.adb", "run_file_engine_tests.adb", "run_repair_tests.adb", "run_retention_batch_tests.adb", "run_enterprise_pkg_tests.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-gnatVa", "-gnatwe", "-fstack-protector-strong", "-fPIE", "-ffile-prefix-map=" & Tests'Project_Dir & "=/usr/src/niaos/pkgcore/", "-g", "-gno-record-gcc-switches", "-O1");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use
        ("-lsodium", "-larchive", "-lcurl", "-lxml2", "-pie", "-Wl,-z,relro,-z,now,-z,noexecstack");
   end Linker;
end Tests;
