-- SPDX-License-Identifier: BSD-3-Clause
project Pkgcore is
   for Languages use ("Ada", "C");
   for Source_Dirs use ("src", "vendor/resolver/src", "runtime", "vendor/contracts/src", "vendor/contracts/runtime", "app");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build/bin";
   for Main use ("pkg_recoveryctl.adb", "pkgctl.adb", "pkg_worker.adb", "pkg_scrubctl.adb", "pkg_store_bootstrap.adb", "pkg_supply_observe.adb", "pkg_operator_guard.adb", "pkg_supply_guard.adb", "pkg_catalog_query.adb");
   package Compiler is
      for Default_Switches ("C") use ("-std=c11", "-Wall", "-Wextra", "-Werror", "-fstack-protector-strong", "-fPIE", "-D_FORTIFY_SOURCE=3", "-ffile-prefix-map=" & Pkgcore'Project_Dir & "=/usr/src/niaos/pkgcore/", "-g", "-gno-record-gcc-switches", "-O1");
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-gnatVa", "-gnatwe", "-fstack-protector-strong", "-fPIE", "-ffile-prefix-map=" & Pkgcore'Project_Dir & "=/usr/src/niaos/pkgcore/", "-g", "-gno-record-gcc-switches", "-O1");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use
        ("-lsystemd", "-lsodium", "-larchive", "-lz", "-lbz2", "-llzma", "-lzstd", "-lcurl", "-lxml2", "-pie", "-Wl,-z,relro,-z,now,-z,noexecstack");
   end Linker;
end Pkgcore;
