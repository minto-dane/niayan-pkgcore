-- SPDX-License-Identifier: MIT
project Pkgcore is
   for Languages use ("Ada");
   for Source_Dirs use ("src", "vendor/resolver/src", "runtime", "vendor/contracts/src", "vendor/contracts/runtime", "app");
   for Object_Dir use "build/obj";
   for Exec_Dir use "build/bin";
   for Main use ("pkg_recoveryctl.adb", "pkgctl.adb", "pkg_worker.adb", "pkg_scrubctl.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-gnatVa", "-gnatwe", "-fstack-protector-strong", "-fPIE", "-g", "-O1");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use
        ("-lsodium", "-larchive", "-lcurl", "-lxml2", "-pie", "-Wl,-z,relro,-z,now,-z,noexecstack");
   end Linker;
end Pkgcore;
